# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
MONGO_URI=mongodb://localhost:27017/flipkart-genius

# Redis Configuration (For BullMQ queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Security
JWT_SECRET=your_jwt_secret_token_here
JWT_EXPIRE=30d

# GenAI API Keys (Configure at least one)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
